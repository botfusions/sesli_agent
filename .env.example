# --- Gemini erişimi (ikisinden biri) ---
# 1) Google AI Studio anahtarı
GEMINI_API_KEY=
# 2) Vertex AI (true yapılırsa anahtar yerine gcloud kimliği kullanılır)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Vertex servis hesabı JSON dosyası (repoya koymayın)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Modeller (28-09-2026: AI Studio ve Vertex us-central1 üzerinde test edildi) ---
# Yedek canlı model: gemini-2.5-flash-native-audio-preview-09-2025 (AI Studio) / gemini-live-2.5-flash-native-audio (Vertex)
LIVE_MODEL=gemini-3.8-live
SUMMARY_MODEL=gemini-3.8-flash
# Vertex: metin modeli yalnızca "global" bölgede
SUMMARY_LOCATION=global

# --- Uygulama ---
AGENTS_DIR=./agents
DATABASE_PATH=./data/voice-agent.db
# Boş bırakılırsa /admin kapalıdır. Uzun, rastgele bir değer verin.
ADMIN_TOKEN=
PUBLIC_BASE_URL=http://localhost:8090
PORT=8090

# --- Araç imzaları (asistan YAML'ındaki secret_env adlarıyla eşleşir) ---
BOOK_DEMO_SECRET=
