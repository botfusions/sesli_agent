# --- Gemini erişimi (ikisinden biri) ---
# 1) Google AI Studio anahtarı
GEMINI_API_KEY=
# 2) Vertex AI (true yapılırsa anahtar yerine gcloud kimliği kullanılır)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Vertex servis hesabı JSON dosyası (repoya koymayın)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Modeller (28-09-2026: AI Studio ve Vertex us-central1 üzerinde test edildi) ---
# Yedek canlı model: gemini-2.5-flash-native-audio-preview-09-2025 (AI Studio) / gemini-live-2.5-flash-native-audio (Vertex)
LIVE_MODEL=gemini-3.8-live
SUMMARY_MODEL=gemini-3.8-flash
# Vertex: metin modeli yalnızca "global" bölgede
SUMMARY_LOCATION=global

# --- Uygulama ---
AGENTS_DIR=./agents
DATABASE_PATH=./data/voice-agent.db
# Boş bırakılırsa /admin kapalıdır. Uzun, rastgele bir değer verin.
ADMIN_TOKEN=
PUBLIC_BASE_URL=http://localhost:8090
PORT=8090

# --- Araç imzaları (asistan YAML'ındaki secret_env adlarıyla eşleşir) ---
BOOK_DEMO_SECRET=

# --- CRM (BOTCRm / Supabase) — yalnızca sunucuda; istemciye asla gönderilmez ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Takvim (randevu müsaitliği + etkinlik) ---
# Takvim ID (Google Takvim → takvim ayarları → "Takvim Kimliği", ör. abc@group.calendar.google.com).
# Takvim, GOOGLE_APPLICATION_CREDENTIALS servis hesabının e-postasıyla "Etkinliklerde değişiklik yapma"
# yetkisiyle paylaşılmalı ve GCP projesinde Google Calendar API açık olmalı. Boşsa takvim adımı atlanır.
GOOGLE_CALENDAR_ID=

# --- Telefon hattı (Netgsm SIP → Asterisk → AudioSocket) ---
# Açmak için: TELEPHONY_ENABLED=true ve "docker compose --profile telephony up -d --build"
TELEPHONY_ENABLED=
# voice-agent'ın AudioSocket dinleme adresi/portu (boşsa 0.0.0.0 / 9092). Port dışarı açılmaz.
AUDIOSOCKET_HOST=
AUDIOSOCKET_PORT=
# Asterisk ile voice-agent arasındaki ortak gizli anahtar (ör. openssl rand -hex 32). ';' içermesin.
TELEPHONY_SECRET=
# Telefonu karşılayacak asistanın id'si (agents/*.yaml; boşsa botfusions-satis)
TELEPHONY_AGENT=
# Netgsm SIP trunk bilgileri (Netgsm panelinden). Boşsa yalnızca test softphone'u çalışır.
NETGSM_SIP_USER=
NETGSM_SIP_PASSWORD=
# SIP sunucu adresi — Netgsm panelindeki değeri yazın (yalnızca alan adı/IP, port yok)
NETGSM_SIP_SERVER=
# Sunucunun sabit genel IP'si (bilgisayarda test için 127.0.0.1)
EXTERNAL_IP=
# RTP (ses) UDP port aralığı (boşsa 10000-10100; güvenlik duvarında da açın)
RTP_START=
RTP_END=
# Yerel test softphone'u (kullanıcı 1001, numara 100). Boşsa kapalı; en az 12 karakter.
SOFTPHONE_PASSWORD=
